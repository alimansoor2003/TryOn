# ---------------------------------------------------------------------------
# Replicate — powers the high-res AI try-on (IDM-VTON) behind /api/tryon.
# Get a token at https://replicate.com/account/api-tokens
#
# Local dev:  copy this file to `.env.local` and fill in the value.
# Production: add the same key in the Vercel dashboard under
#             Project -> Settings -> Environment Variables.
#
# NOTE: no VITE_ prefix. Anything prefixed with VITE_ is inlined into the client
# bundle and would hand your token to every shopper who scans a QR code. This
# variable is read only inside api/tryon.js, on the server.
# ---------------------------------------------------------------------------
REPLICATE_API_TOKEN=r8_your_token_here

# Replicate model slug. Left unpinned so the client resolves the latest version.
# For a demo you are going to repeat in front of customers, pin it instead:
# open https://replicate.com/cuuupid/idm-vton/versions, copy the hash of the
# version you tested, and set IDM_VTON_MODEL=cuuupid/idm-vton:<hash>
IDM_VTON_MODEL=cuuupid/idm-vton

# Absolute origin used to turn relative garment paths (/garments/...) into the
# public URLs Replicate fetches from. Vercel sets VERCEL_URL automatically, so
# you only need this when testing locally through a tunnel.
# PUBLIC_ORIGIN=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Front-end. Set this after running `npm run vendor:model` to serve the
# pose model from your own origin instead of the public CDN.
# ---------------------------------------------------------------------------
# VITE_MODEL_BASE=/mediapipe
