# ---------------------------------------------------------------------------
# Which service generates the try-on. Defaults to `gemini`.
#
#   huggingface  Free, no account needed. Calls yisol/IDM-VTON, the Space the
#                IDM-VTON authors publish, on Hugging Face's ZeroGPU. Same model
#                Replicate charges for. Measured ~29s end to end. Shared public
#                infrastructure, so it queues and can be paused by its owner.
#
#   gemini       PAID as of writing. Google moved image generation off the free
#                tier — free-tier keys report `limit: 0` for every image model.
#                Needs billing enabled in AI Studio.
#   replicate  Paid, ~cents per run. IDM-VTON is purpose-built for try-on and
#              gives better garment fidelity. Accounts with no payment method
#              are throttled to ~6 predictions/minute, which stalls a demo.
# ---------------------------------------------------------------------------
VTON_PROVIDER=huggingface

# ---------------------------------------------------------------------------
# Hugging Face (the free path). No token is required at all — leave this unset
# and it still works anonymously. Setting one (free, no card, from
# https://huggingface.co/settings/tokens) raises the ZeroGPU quota, which is
# worth doing before demoing to anyone.
# ---------------------------------------------------------------------------
# HF_TOKEN=hf_your_token_here

# Point at a different Space (must expose the same /tryon signature).
# HF_SPACE=yisol/IDM-VTON

# ---------------------------------------------------------------------------
# Gemini (paid). Key from https://aistudio.google.com/apikey — but image
# generation now requires billing enabled; free-tier keys get `limit: 0`.
#
# NOTE: no VITE_ prefix on any of these. Vite inlines VITE_* into the client
# bundle, which would hand your key to every shopper who scans a QR code. These
# are read only inside api/, on the server.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_key_here

# Override only to move to a different image model.
# GEMINI_MODEL=gemini-3.1-flash-image

# ---------------------------------------------------------------------------
# Replicate (optional, only when VTON_PROVIDER=replicate).
# Token: https://replicate.com/account/api-tokens
# ---------------------------------------------------------------------------
# REPLICATE_API_TOKEN=r8_your_token_here

# Model slug. Left unpinned so the server resolves the latest version at cold
# start. For a demo you intend to repeat, pin a tested one instead:
# open https://replicate.com/cuuupid/idm-vton/versions and copy a hash.
# IDM_VTON_MODEL=cuuupid/idm-vton

# ---------------------------------------------------------------------------
# Absolute origin used to turn relative garment paths (/garments/...) into the
# public URLs a provider fetches. Vercel sets VERCEL_URL automatically, so you
# only need this when testing locally through a tunnel.
# ---------------------------------------------------------------------------
# PUBLIC_ORIGIN=https://your-app.vercel.app
